# ==============================================================================
# TerraPulse — Global Air & Ocean Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Server configuration
PORT=5000
FLASK_ENV=production
DEBUG=False

# OpenAQ API v3 Key (required for live global countries, stations, and sensor feeds)
# Free registration available at: https://openaq.org/
# If left empty, only the small built-in reference station list is available.
OPENAQ_API_KEY=

# Meteorological & Oceanographic Endpoints (No API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
COPERNICUS_CMEMS_URL=https://marine.copernicus.eu/

# Model & Preprocessing configuration
MODEL_PATH=backend/models/aqi_model.joblib
SCALER_PATH=backend/models/scaler.joblib
METADATA_PATH=backend/models/model_metadata.json
